rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /skill-exam-recordings/{ownerId}/{templateId}/{questionId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
