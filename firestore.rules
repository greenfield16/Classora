rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated (Admins)
    function isAuthed() {
      return request.auth != null;
    }

    // Publicly readable for students to take exams, only writeable by Admins
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAuthed();

      match /answerKeys/{keyId} {
        allow read, write: if isAuthed();
      }
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // Restrict all other collections to authenticated Admins only
    match /attempts/{attemptId} {
      allow read, write: if isAuthed();
    }

    match /students/{studentId} {
      allow read, write: if isAuthed();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /quizSets/{setId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /quizSessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthed();

      match /{document=**} {
        allow read: if true;
        allow write: if isAuthed();
      }
    }

    match /pollSets/{setId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /pollSessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthed();

      match /{document=**} {
        allow read: if true;
        allow write: if isAuthed();
      }
    }

    match /flashcardSets/{setId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    match /flashcardProgress/{progressId} {
      allow read, write: if true;
    }

    match /flashcard_sets/{setId} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthed() && resource.data.ownerId == request.auth.uid;
    }

    match /flashcard_progress/{progressId} {
      allow read, write: if true;
    }

    // Skill-based exams: teachers own templates; published templates are readable by students.
    match /skillExamTemplates/{templateId} {
      allow read: if resource.data.status == 'PUBLISHED'
        || (isAuthed() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthed() && resource.data.ownerId == request.auth.uid;
    }

    // Students are anonymous on the public exam page. They can only create a submission;
    // teachers read submissions through their authenticated session.
    match /skillExamSubmissions/{submissionId} {
      allow create: if request.resource.data.templateId is string
        && request.resource.data.accessCode is string
        && request.resource.data.ownerId is string
        && request.resource.data.student.fullName is string;
      allow read: if isAuthed() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isAuthed() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthed() && resource.data.ownerId == request.auth.uid;
    }
  }
}
