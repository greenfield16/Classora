# Reference only. Backend loads backend/.env, frontend loads frontend/.env.local.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=classora_local
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
# Optional object storage: leave empty if uploads are not tested.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=green-exams-local
R2_PUBLIC_URL=
R2_ENDPOINT=
# Optional AI: only a server-side OpenAI key is required.
OPENAI_API_KEY=

# Local recordings directory; back up alongside MongoDB.
UPLOAD_DIR=./uploads
