{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "hosting": {
    "public": "frontend/out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/login",
        "destination": "/admin/login.html"
      },
      {
        "source": "/admin/exam-print/**",
        "destination": "/admin/exam-print/placeholder.html"
      },
      {
        "source": "/admin/exam-sheet/**",
        "destination": "/admin/exam-sheet/placeholder.html"
      },
      {
        "source": "/admin/skills-exam-print/**",
        "destination": "/admin/skills-exam-print/placeholder.html"
      },
      {
        "source": "/e/**",
        "destination": "/e/placeholder.html"
      },
      {
        "source": "/quiz/live/**",
        "destination": "/quiz/live/placeholder.html"
      },
      {
        "source": "/quiz/flashcard/**",
        "destination": "/quiz/flashcard/placeholder.html"
      },
      {
        "source": "/quiz/matching/**",
        "destination": "/quiz/matching/placeholder.html"
      },
      {
        "source": "/skills/**",
        "destination": "/skills/placeholder.html"
      },
      {
        "source": "/poll/live/**",
        "destination": "/poll/live/placeholder.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "/classora-wordmark.svg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
